# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (SMTP). SMTP_URL e.g. smtps://user:pass@smtp.gmail.com:465  (Gmail: use an App Password)
ADMIN_EMAIL=""          # receives consultation + enrollment emails
SMTP_URL=""
EMAIL_FROM=""           # optional, defaults to ADMIN_EMAIL

# Razorpay (use rzp_test_ keys in development). Secret is server-only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Google OAuth / Auth.js
AUTH_SECRET="generate-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
